<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RecipeActivity"
    android:layout_margin="10dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Котляров Андрей Александрович Т-423901-НТ ИСТ"
            android:layout_gravity="fill_horizontal"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/langB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lang_b" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/playB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="fill_horizontal"
                    android:layout_weight="1"
                    android:text="@string/play_b"/>
                <Button
                    android:id="@+id/resetB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="fill_horizontal"
                    android:layout_weight="1"
                    android:text="@string/reset_b"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/recipeIV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:minHeight="100dp"/>
            <TextView
                android:id="@+id/recipeTitleTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textFontWeight="500"
                android:textSize="32sp"/>
            <TextView
                android:id="@+id/recipeTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/timerLL1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="visible">
                    <TextView
                        android:id="@+id/timerTV1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="07:00"
                        android:textSize="24sp"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:layout_weight="1"
                        />
                    <Button
                        android:textSize="12sp"
                        android:layout_margin="2dp"
                        android:id="@+id/timerPlayB1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/play_b"/>
                    <Button
                        android:textSize="12sp"
                        android:layout_margin="2dp"
                        android:id="@+id/timerPauseB1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pause_b"/>
                    <Button
                        android:textSize="12sp"
                        android:layout_margin="2dp"
                        android:id="@+id/timerResetB1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reset_b"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/timerLL2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="visible">
                    <TextView
                        android:id="@+id/timerTV2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="15:00"
                        android:textSize="24sp"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:layout_weight="1"/>
                    <Button
                        android:textSize="12sp"
                        android:layout_margin="2dp"
                        android:id="@+id/timerPlayB2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/play_b"/>
                    <Button
                        android:textSize="12sp"
                        android:layout_margin="2dp"
                        android:id="@+id/timerPauseB2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pause_b"/>
                    <Button
                        android:textSize="12sp"
                        android:layout_margin="2dp"
                        android:id="@+id/timerResetB2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reset_b"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/timerLL3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="visible">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center">
                        <EditText
                            android:id="@+id/timer3ET1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00"
                            android:inputType="number"
                            android:textAlignment="center"
                            android:textSize="20sp"/>
                        <TextView
                            android:id="@+id/timerTV3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=":"
                            android:textSize="20sp"
                            android:layout_gravity="center"
                            android:textAlignment="center" />
                        <EditText
                            android:id="@+id/timer3ET2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00"
                            android:inputType="number"
                            android:textAlignment="center"
                            android:textSize="20sp"/>
                    </LinearLayout>

                    <Button
                        android:textSize="12sp"
                        android:layout_margin="2dp"
                        android:id="@+id/timerPlayB3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/play_b"/>
                    <Button
                        android:textSize="12sp"
                        android:layout_margin="2dp"
                        android:id="@+id/timerPauseB3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pause_b"/>
                    <Button
                        android:textSize="12sp"
                        android:layout_margin="2dp"
                        android:id="@+id/timerResetB3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reset_b"/>
                </LinearLayout>

            </LinearLayout>

            <VideoView
                android:id="@+id/recipeVW"
                android:layout_width="match_parent"
                android:layout_height="500dp"
                android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>





</LinearLayout>