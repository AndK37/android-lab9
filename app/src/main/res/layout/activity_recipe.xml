<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RecipeActivity"
    android:layout_margin="10dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Котляров Андрей Александрович Т-423901-НТ ИСТ"
            android:layout_gravity="fill_horizontal"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/langB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lang_b" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/playB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="fill_horizontal"
                    android:layout_weight="1"
                    android:text="@string/play_b"/>
                <Button
                    android:id="@+id/resetB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="fill_horizontal"
                    android:layout_weight="1"
                    android:text="@string/reset_b"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/recipeIV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:minHeight="100dp"/>
            <TextView
                android:id="@+id/recipeTitleTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textFontWeight="500"
                android:textSize="32sp"/>
            <TextView
                android:id="@+id/recipeTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <VideoView
                android:id="@+id/recipeVW"
                android:layout_width="match_parent"
                android:layout_height="500dp" />
        </LinearLayout>
    </ScrollView>





</LinearLayout>